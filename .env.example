PORT=3000

# Signs inbox login sessions. REQUIRED in production.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# SQLite database file (created automatically).
DATABASE_FILE=./data/chatdesk.db

# Public https URL of this server, e.g. https://chat.example.com
# Needed so Twilio webhooks can be verified.
PUBLIC_URL=

# Country code added to local phone numbers typed into the widget,
# e.g. +61 turns 0400 123 456 into +61400123456. Leave empty to require +E.164.
DEFAULT_COUNTRY_CODE=+61

# Optional: Twilio, for replying by text and receiving texts in the inbox.
# Each business sets its own Twilio number under Settings.
# Point the number's "A message comes in" webhook at  PUBLIC_URL/api/sms/inbound
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Optional: AI-suggested replies (the "Suggest reply" button). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Accurate voicemail transcripts (OpenAI speech-to-text). Without it, Twilio's built-in transcription is used.
# Can also be entered under Integrations -> Server keys. Optional: OPENAI_TRANSCRIBE_MODEL (default gpt-4o-transcribe, or whisper-1).
OPENAI_API_KEY=
# Defaults to claude-opus-5-5. Each suggestion is one API call, billed to your Anthropic account.
ANTHROPIC_MODEL=

# Optional: email alerts when a customer messages and nobody has the inbox open.
# Works with any SMTP provider (Gmail app password, Microsoft 365, Postmark, SendGrid, Mailgun…).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ChatBird <alerts@example.com>"

# Optional: connected accounts (Integrations page). Setup: docs/INTEGRATIONS.md
# Google Business Profile reviews
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook Messenger + Instagram DMs (a Meta app)
META_APP_ID=
META_APP_SECRET=
# Any random string; enter the same value as the webhook "verify token" in the Meta app.
META_VERIFY_TOKEN=
# Business-type apps (Facebook Login for Business): the login configuration ID from the app dashboard.
META_LOGIN_CONFIG_ID=
# Key for encrypting connected-account tokens. Defaults to JWT_SECRET.
TOKEN_ENCRYPTION_KEY=
