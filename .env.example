PORT=3000

# Signs inbox login sessions. REQUIRED in production.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# SQLite database file (created automatically).
DATABASE_FILE=./data/chatdesk.db

# Public https URL of this server, e.g. https://chat.example.com
# Needed so Twilio webhooks can be verified.
PUBLIC_URL=

# Country code added to local phone numbers typed into the widget,
# e.g. +61 turns 0400 123 456 into +61400123456. Leave empty to require +E.164.
DEFAULT_COUNTRY_CODE=+61

# Optional: Twilio, for replying by text and receiving texts in the inbox.
# Each business sets its own Twilio number under Settings.
# Point the number's "A message comes in" webhook at  PUBLIC_URL/api/sms/inbound
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
